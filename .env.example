# Host path to the tiles-processor data directory (contains seed/, glm_h5/, radar_h5/, wrf_nc/)
TILES_DATA_DIR=../tiles-processor/data

# Host port for the status API
SIM_PORT=6030

# Per-source toggles and cadences (UTC clock-aligned minutes)
SIM_GLM_ENABLED=true
SIM_GLM_INTERVAL_MINUTES=10
SIM_GLM_RETENTION_MINUTES=180

SIM_RADAR_ENABLED=true
SIM_RADAR_INTERVAL_MINUTES=10
SIM_RADAR_RETENTION_MINUTES=180

SIM_WRF_ENABLED=true
SIM_WRF_INTERVAL_MINUTES=360
SIM_WRF_RETENTION_MINUTES=1080

# hardlink (instant, zero extra disk) or copy (use if inputs are ever mutated in place)
SIM_LINK_MODE=hardlink
