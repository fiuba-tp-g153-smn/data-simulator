# Read-only master raw-data folders (the simulator replays FROM these, never writes).
#   glm_h5     → CG_GLM-L2-GLMF-*.nc
#   radar_h5   → RMAx/*.H5
#   wrf_nc     → WRF_*FIELD2D*.nc (+ matching FIELD3D siblings)
#   radar-inta → <STATION>/*.vol, one folder per INTA radar (PAR, ANG, PER)
GLM_SEED_DIR=~/raw_data/glm_raw_data/glm_h5
RADAR_SEED_DIR=~/raw_data/radar_h5
WRF_SEED_DIR=~/raw_data/wrf_raw_data/wrf_nc
INTA_SEED_DIR=~/raw_data/radar-inta

# tiles-processor data dir — emissions land in its watched dirs (glm_h5,
# radar_h5, wrf_nc, radar-inta). For a Coolify/Docker named volume, find it with:
#   docker volume ls | grep tiles-data
# then use /var/lib/docker/volumes/<name>/_data
# Keep this on the same filesystem as the seed folders so radar/WRF hardlink.
TILES_DATA_DIR=/var/lib/docker/volumes/<tiles-data-volume>/_data

# Host port for the status API
SIM_PORT=6030
